[3.896118, "o", "***База данных***\r\ncreate_table <имя> <столбец:тип> ...\r\ndrop_table <имя>\r\nlist_tables\r\ninsert into <имя> values (<значение>, ...)\r\nselect from <имя> [where <столбец> = <значение>] [order by <столбец>]\r\nupdate <имя> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <имя> where <столбец> = <значение>\r\ninfo <имя>\r\nhelp\r\nexit\r\nСтроковые значения указывайте в кавычках, например \"Sergei\".\r\nВведите команду: "]
